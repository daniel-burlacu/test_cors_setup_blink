        </mxCell>
        <mxCell id="Z8g4_nnyIk-NAU937-aJ-16" value="- id(VARCHAR(36))PK - unique&lt;br&gt;- name(VARCHAR(64)) UNIQUE NOT NULL &#39;&quot;USER,&quot;ANIMAL&quot;,&quot;VETERINARY&quot;, &quot;VISIT&quot;" style="align=left;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;fontSize=12;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;whiteSpace=wrap;" vertex="1" parent="Z8g4_nnyIk-NAU937-aJ-15">
