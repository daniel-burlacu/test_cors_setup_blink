        <mxCell id="zZC2qIHttG79nF3NMsGn-7" value="+ Only entities that belongs&amp;nbsp; to the Veterinary Association should be able to make changes to owner and animal PDA&#39;s" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="zZC2qIHttG79nF3NMsGn-1" vertex="1">
