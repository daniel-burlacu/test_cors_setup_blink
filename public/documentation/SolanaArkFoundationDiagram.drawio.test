        <mxCell id="Z8g4_nnyIk-NAU937-aJ-2" value="- id(VARCHAR(36)) PK - unique&lt;br&gt;- appointmentId&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(VARCHAR(36)) fk_appointments_id NOT NULL&lt;/span&gt;&lt;div&gt;- animalId(VARCHAR(36)) fk_animal_id NOT NULL&lt;/div&gt;&lt;div&gt;- ownerId(VARCHAR(36)) fk_owner_id NOT NULL&lt;/div&gt;&lt;div&gt;- visitId(VARCHAR(36)) fk_visits_it NULLABLE&lt;/div&gt;&lt;div&gt;- surgeryId(VARCHAR(36)) fk_surgeries_id NULLABLE&lt;/div&gt;&lt;div&gt;- treatmentId (VARCHAR(36)) fk_treatments_id NULLABLE&lt;/div&gt;&lt;div&gt;- invoiceNumber(VARCHAR(36)) UNIQUE NOT NULL&lt;/div&gt;&lt;div&gt;- description(VARCHAR(255))&amp;nbsp;&lt;/div&gt;&lt;div&gt;- amount(DECIMAL(10,2)) NOT NULL&lt;/div&gt;&lt;div&gt;- discount(DECIMAL(10,2)) DEFAULT 0.00&lt;/div&gt;&lt;div&gt;- tax(DECIMAL(10,2)) DEFAULT 0.00&lt;/div&gt;&lt;div&gt;- finalAmount(DECIMAL(10,2)) GENERATED ALWAYS AS (AMOUNT-DISCOUNT+TAX) STORED&lt;/div&gt;&lt;div&gt;- status(ENUM(&quot;PENDING&quot;,&quot;PAID&quot;,&quot;CANCELED&quot;,&quot;REFUNDED&quot;)) - DEFAULT &quot;PENDING&quot;&lt;/div&gt;&lt;div&gt;- paymentMethod(ENUM(&quot;CASH&quot;,&quot;CARD&quot;,&quot;TRANFER&quot;,&quot;INSURANCE&quot;,&quot;CRYPTO&quot;,&quot;OTHER&quot;)) DEFAULT &quot;OTHER&quot;&lt;/div&gt;&lt;div&gt;- paymentDate(DATETIME(6))&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;- addedAt(DATETIME(6))&lt;/div&gt;&lt;div&gt;- updatedAt(DATETIME(6))&lt;/div&gt;&lt;/div&gt;&lt;div&gt;COMPOSITE INDEX idx_billing_ownerId_date ON Billing(ownerId, paymentDate)&lt;/div&gt;&lt;div&gt;INDEX idx_billing_status ON Billing(status)&lt;/div&gt;&lt;div&gt;INDEX idx_billing_invoice ON Billing(invoiceNumber)&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="align=left;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;fontSize=12;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;whiteSpace=wrap;" vertex="1" parent="Z8g4_nnyIk-NAU937-aJ-1">
