        <mxCell id="Ku_dHCeT_9K8U9IJu_T0-11" value="AUDIT_LOGS" style="swimlane;childLayout=stackLayout;horizontal=1;startSize=50;horizontalStack=0;rounded=1;fontSize=14;fontStyle=0;strokeWidth=2;resizeParent=0;resizeLast=1;shadow=0;dashed=0;align=center;arcSize=4;whiteSpace=wrap;html=1;" vertex="1" parent="Wi551SWM2cRamMvrgl9W-91">
