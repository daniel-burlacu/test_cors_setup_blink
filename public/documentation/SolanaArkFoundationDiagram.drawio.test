        <mxCell id="cvtiSawDCd0xw21VSJTq-1" value="TRANSFERS SOL&lt;div&gt;FROM DAO VAULT ACCOUTN&lt;/div&gt;&lt;div&gt;TO PROGRAM TREASURY ACCOUNT&lt;/div&gt;" style="endArrow=open;html=1;endSize=12;startArrow=diamondThin;startSize=14;startFill=0;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="GEga7pHQwOTUdIS_QKCw-520" source="GEga7pHQwOTUdIS_QKCw-555" target="RrcLKaXOxfJI_AQqpu18-24" edge="1">
