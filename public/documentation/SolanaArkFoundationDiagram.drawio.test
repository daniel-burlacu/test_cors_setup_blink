        <mxCell id="zZC2qIHttG79nF3NMsGn-4" value="+ On veterinary registration, there should be a DAO system of approval&amp;nbsp;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" parent="zZC2qIHttG79nF3NMsGn-1" vertex="1">
