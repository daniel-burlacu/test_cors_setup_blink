        <mxCell id="Ku_dHCeT_9K8U9IJu_T0-12" value="- id(VARCHAR(36))PK - unique&lt;div&gt;- entityTypeId(INT) fk_entity_types.id NOT NULL&lt;/div&gt;&lt;div&gt;- entityId UUID NOT NULL&lt;/div&gt;&lt;div&gt;- action(ENUM(&quot;CREATED&quot;,&quot;UPDATED&quot;,&quot;DELETED&quot;))&lt;/div&gt;&lt;div&gt;&lt;div&gt;- performById(VARCHAR(36)) fk_audit_roles_userId NOT NULL&amp;nbsp;&lt;div&gt;&lt;div&gt;- addedAt(VARCHAR(36))&lt;/div&gt;&lt;div&gt;- updatedAt(VARCHAR(36))&lt;/div&gt;&lt;div&gt;- oldValue JSONB&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;- newValue JSONB&lt;/div&gt;&lt;div&gt;- INDEX idx_audit_logs_entity ON AUDIT_LOGS(entityName, entityId)&lt;/div&gt;&lt;div&gt;- UNIQUE(entityId, performedById)&lt;/div&gt;&lt;/div&gt;" style="align=left;strokeColor=none;fillColor=none;spacingLeft=4;spacingRight=4;fontSize=12;verticalAlign=top;resizable=0;rotatable=0;part=1;html=1;whiteSpace=wrap;" vertex="1" parent="Ku_dHCeT_9K8U9IJu_T0-11">
          <mxGeometry y="50" width="455" height="180" as="geometry" />
        </mxCell>
